{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./supabase/.env)",
      "Bash(supabase db push:*)",
      "Bash(supabase link:*)",
      "Bash(git:*)",
      "Bash(gh:*)"
    ],
    "ask": [
      "Bash(npm install:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/session-start.mjs" }
        ]
      }
    ]
  }
}
