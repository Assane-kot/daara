{
    "semi": true,
    "singleQuote": true,
    "printWidth": 160,
    "plugins": ["prettier-plugin-tailwindcss"],
    "overrides": [
        {
            "files": "*.html",
            "options": {
                "parser": "angular"
            }
        }
    ],
    "tailwindStylesheet": "./src/styles.css"
}
